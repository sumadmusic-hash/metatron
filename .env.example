# Copy to `.env` and adjust if you have your own Audiotool OAuth client.
# If unset, the POC code falls back to the shared dev client id
# ("e498c930-864a-4ef0-8d57-b8a176bee096") used by the productive Metatron PoC.
# The app's origin must be registered as a redirect origin for the client.
VITE_AUDIOTOOL_CLIENT_ID=your-audiotool-oauth-client-id